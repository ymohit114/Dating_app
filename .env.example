# MongoDB Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/elance?retryWrites=true&w=majority

# JWT Auth Secrets
JWT_ACCESS_SECRET=your_short_lived_access_token_secret_key_15m
JWT_REFRESH_SECRET=your_long_lived_refresh_token_secret_key_7d

# App Domain
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cloud Object Storage (for photo uploads: Cloudinary or S3 bucket)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional Payments (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
